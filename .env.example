# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Web Push (VAPID) Keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your-email@example.com

# Discord OAuth2 & Moderator Configuration
DISCORD_CLIENT_ID=your-discord-oauth-client-id
DISCORD_CLIENT_SECRET=your-discord-oauth-client-secret
# Comma-separated Discord snowflake user IDs with moderator privileges
MOD_DISCORD_IDS=123456789012345678,987654321098765432


NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# Moderator Passcode (Required in production)
MOD_SECRET_PASSCODE=your-secret-mod-passcode

# Cron Job Authorization Secret (Required for Vercel Cron or external triggers)
CRON_SECRET=your-random-cron-secret-token

# Discord Community Webhook (Posts bedtime announcements & morning recap digests)
DISCORD_COMMUNITY_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/token

# Cryptographic Salts & Secrets (Recommended: set strong random 32+ char strings in production.
# If omitted on deployment platforms, the system safely falls back to keys deterministically derived from server credentials)
SESSION_SECRET=your-production-hmac-session-secret-key-32-chars
PIN_SALT=your-production-pin-salt-string
